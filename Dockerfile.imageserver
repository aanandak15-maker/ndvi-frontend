# Minimal Railway deployment - Image server only (no AI model required)
FROM python:3.10-slim

WORKDIR /app

# Install only essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements_minimal.txt .

# Install Python packages with aggressive optimization
RUN pip install --no-cache-dir -r requirements_minimal.txt

# Copy only image server (no model needed)
COPY image_server.py .

# Expose port
EXPOSE 8000

# Start image server (no AI model required) - use PORT env var from Railway
CMD ["sh", "-c", "uvicorn image_server:app --host 0.0.0.0 --port ${PORT:-8000}"]
